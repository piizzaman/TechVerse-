# Copy this file to .env and fill in values locally. Never commit .env.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/techverse?schema=public"
JWT_SECRET="replace-with-a-long-random-secret"
ADMIN_USERNAME="admin"
# Generate a bcrypt hash for the admin password; do not store a plain-text password.
ADMIN_PASSWORD_HASH="replace-with-bcrypt-hash"
# Optional. Stripe checkout remains disabled unless this is configured.
STRIPE_SECRET_KEY=""
PORT=5001
